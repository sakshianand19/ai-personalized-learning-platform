# Azure OpenAI (leave empty to use the built-in heuristic fallback)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Database: SQLite by default; any Postgres URL (Neon, Supabase, Vercel Postgres) also works
# DATABASE_URL=postgresql://user:password@host/dbname
SEED_DEMO_DATA=true

# Learning-gap tuning
MASTERY_THRESHOLD=0.6
MIN_ATTEMPTS_FOR_GAP=2

# Session signing key: set a long random value in production (all instances must share it)
# SECRET_KEY=replace-with-a-long-random-string
SESSION_HOURS=8
